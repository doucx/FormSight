        "src/types/card.ts",
        "src/types/index.ts",
        "src/components/settings/DynamicDomainSettings.tsx",
        "src/modules/star/",
      ]
    },
    "core": {
      "format": "xml",
      "extension": ["ts", "tsx"],
      "paths": [
